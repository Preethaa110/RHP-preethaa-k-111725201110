#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {
    string s1, s2;
    cin >> s1 >> s2;

    int n = s1.length();
    int m = s2.length();

    // DP table: dp[i][j] = length of LCS of s1[0..j-1], s2[0..i-1]
    vector<vector<int>> dp(m + 1, vector<int>(n + 1, 0));

    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {
            if (s2[i - 1] == s1[j - 1])
                dp[i][j] = dp[i - 1][j - 1] + 1;
            else
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
        }
    }

    // Length of LCS
    cout << "Length of LCS = " << dp[m][n] << endl;

    // Reconstruct the LCS string
    string lcs = "";
    int i = m, j = n;
    while (i > 0 && j > 0) {
        if (s2[i - 1] == s1[j - 1]) {
            lcs = s1[j - 1] + lcs;
            i--; j--;
        } else if (dp[i - 1][j] > dp[i][j - 1]) {
            i--;
        } else {
            j--;
        }
    }

    cout << "LCS = " << lcs << endl;

    return 0;
}
