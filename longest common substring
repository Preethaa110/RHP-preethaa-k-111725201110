#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {
    string s1, s2;
    cin >> s1 >> s2;

    int n = s1.length();
    int m = s2.length();

    // DP table: dp[i][j] = length of longest common suffix of s1[0..j-1], s2[0..i-1]
    vector<vector<int>> dp(m + 1, vector<int>(n + 1, 0));

    int maxlen = 0;
    int end = 0; // end index in s1

    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {
            if (s2[i - 1] == s1[j - 1]) {
                dp[i][j] = dp[i - 1][j - 1] + 1;
                if (dp[i][j] > maxlen) {
                    maxlen = dp[i][j];
                    end = j;
                }
            } else {
                dp[i][j] = 0;
            }
        }
    }

    string ans = (maxlen > 0) ? s1.substr(end - maxlen, maxlen) : "";

    cout << "Length = " << maxlen << endl;
    cout << "Substring = " << ans << endl;

    return 0;
}
