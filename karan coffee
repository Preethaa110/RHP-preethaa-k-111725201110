import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

       
        int n = sc.nextInt();
        int q = sc.nextInt();

        int MAX = 200000; 
        int[] diff = new int[MAX + 1];

        
        for (int i = 0; i < q; i++) {
            int l = sc.nextInt();
            int r = sc.nextInt();
            diff[l]++;        
            diff[r + 1]--;   
        }

        
        int[] temp = new int[MAX + 1];
        temp[0] = diff[0];
        for (int i = 1; i <= n; i++) {
            temp[i] = temp[i - 1] + diff[i];
        }

       
        int[] prefix = new int[MAX + 1];
        for (int i = 1; i <= n; i++) {
            if (temp[i] > 0) {
                prefix[i] = prefix[i - 1] + 1;
            } else {
                prefix[i] = prefix[i - 1];
            }
        }

       
        StringBuilder sb = new StringBuilder();
        int m = sc.nextInt(); // number of queries
        while (m-- > 0) {
            int l = sc.nextInt();
            int r = sc.nextInt();
            sb.append(prefix[r] - prefix[l - 1]).append("\n");
        }

        System.out.print(sb);
        sc.close();
    }
}
